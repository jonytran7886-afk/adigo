{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adigo",
  "main": "worker.ts",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
